{
  "name": "meckie-bodies",
  "version": "1.0.0",
  "private": true,
  "description": "Open-hardware body packs for Meckie OS. Hardware CERN-OHL-S-2.0, code MIT.",
  "license": "MIT",
  "scripts": {
    "validate": "node tools/validate.js",
    "emit": "node tools/emit-json.js",
    "sync": "node tools/sync-template.js",
    "clean-mesh": "node tools/meshclean.js",
    "selftest": "bash tools/selftest.sh",
    "check": "node tools/validate.js && node tools/sync-template.js --check && node tools/emit-json.js --check && bash tools/selftest.sh",
    "reexport": "node tools/reexport.js",
    "diagnose": "node tools/diagnose-mesh.mjs",
    "site": "node tools/serve.js",
    "site-data": "node tools/site-data.js",
    "new-body": "node tools/new-body.js",
    "quote-bundle": "node tools/quote-bundle.js"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.1.0",
    "manifold-3d": "^3.0.0",
    "three": "^0.184.0"
  }
}
