      "servos": [
        {
          "id": 1,
          "name": "pan",
          "model": "sts3215",
          "min_deg": -150,
          "max_deg": 150,
          "rest_deg": 0
        },
        {
          "id": 2,
          "name": "tilt",
          "model": "sts3215",
          "min_deg": -25,
          "max_deg": 35,
          "rest_deg": -25
        }
      ]
    }
  ],
  "led": {
    "pin": 48,
    "part": "ws2812"
  },
  "mic_type": "ics43434",
  "speaker": "max98357a",
  "camera": true,
  "transport": "ws",
  "unsupported": [
    {
      "what": "motor enable pins (ena/enb)",
      "value": "n/a on a DRV8833",
      "reason": "firmware-gen expects an L298N-style enable; a DRV8833 PWMs the input pins directly, so ena/enb would fall back to defaults 14/32"
    },
    {
      "what": "2 serial-bus servo(s) on 1 bus(es)",
      "value": "sts3215",
      "reason": "fw-templates.js implements PWM hobby servos only (ESP32Servo.h, panServo.write(0..180)). No Feetech/STS serial protocol exists in lib/bodies/, so look_at cannot be generated for this body yet"
    },
    {
      "what": "1 Raspberry Pi target(s): face",
      "value": "rpi_zero_2w",
      "reason": "firmware-gen emits PlatformIO ESP32 builds only. The Pi is imaged by the builder and provisioned separately; it is not a flash target"
    }
  ],
  "_generated": {
    "by": "meckie-bodies tools/emit-json.js",
    "from": "bodies/rover-lite/hangar-bay/rover-lite.template.yaml",
