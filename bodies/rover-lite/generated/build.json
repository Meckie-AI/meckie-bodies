{
  "model": "rover-lite",
  "board": "esp32-s3-devkitc-1",
  "body_platform": "espressif32@6.6.0",
  "flash_size": "16MB",
  "arduino": {
    "memory_type": "qio_opi"
  },
  "display": {
    "controller": "gc9a01",
    "width": 240,
    "height": 240,
    "pins": {
      "mosi": 10,
      "sclk": 11,
      "cs": 8,
      "dc": 25,
      "rst": 24,
      "bl": 13
    }
  },
  "motors": {
    "driver": "drv8833",
    "type": "tracked_skid_steer",
    "pins": {
      "ain1": 38,
      "ain2": 39,
      "bin1": 40,
      "bin2": 41
