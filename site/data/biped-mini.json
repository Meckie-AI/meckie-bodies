  ],
  "pairing": {
    "central": "auto_discover",
    "wifi": "from_meckie_app",
    "brain": "account_required"
  },
  "wizard": [
    {
      "step": "servo_ids",
      "prompt": "Connect one servo at a time; Hangar Bay assigns the IDs in this manifest",
      "required": false,
      "writes": null,
      "checks": null,
      "auto": true
    },
    {
      "step": "servo_center",
      "prompt": "Hold each joint at its marked zero and confirm",
      "required": false,
      "writes": "servos[].offset_deg",
      "checks": null,
      "auto": false
    },
    {
      "step": "imu_level",
      "prompt": "Place the body on a flat surface",
      "required": false,
      "writes": "imu.offsets",
      "checks": null,
      "auto": false
    },
    {
      "step": "tof_check",
      "prompt": "Hold a hand 10 cm in front of each sensor",
      "required": false,
      "writes": null,
      "checks": [
        "lidar_fwd",
        "drop_front",
        "drop_rear"
      ],
      "auto": false
    },
    {
      "step": "safety_test",
      "prompt": "Hangar Bay drops the heartbeat; the body must go to its rest pose",
      "required": true,
      "writes": null,
      "checks": null,
      "auto": false
    }
  ],
