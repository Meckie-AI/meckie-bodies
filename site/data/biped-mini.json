  "manifest_text": "body: biped_mini\ndoctrine: thin-client\ncentral: { link: wifi, heartbeat_hz: 10, timeout_ms: 500 }\nmcu:\n  reflex: { chip: esp32s3, module: N16R8, location: chest, role: [gait, ik, sense, power] }\n  face:   { chip: rpi_zero_2w, os: bookworm-lite, location: chest }\npower:\n  battery: { cells: 3, mah: 1000, smart: true, gauge: sbs, balance: true, location: pelvis }\n  charger: { part: bq25798, input: usb_c_pd, request_v: 15 }\nbuses:\n  servo_bus: { host: reflex, uart: 1, tx: 17, rx: 18, baud: 1000000, half_duplex: true, volts: 12 }\n  servo_bus_6v: { host: reflex, uart: 2, tx: 39, rx: 40, baud: 1000000, half_duplex: true, volts: 6 }\n  i2c0:      { host: reflex, sda: 8, scl: 9, hz: 400000 }\n  i2c1_smb:  { host: reflex, sda: 1, scl: 2, hz: 100000 }\n  link:      { reflex: { uart: 0, tx: 15, rx: 16 }, face: { uart: 0, tx: 14, rx: 15 }, baud: 921600 }\n  spi0:      { host: face, mosi: 10, sclk: 11, cs: 8, hz: 40000000 }\n  i2s:       { host: face, bclk: 18, lrclk: 19, din: 20, dout: 21, rate: 48000 }\n  csi:       { host: face, port: cam0, ffc_mm: 60 }\nlegs:\n  config: ankle_roll\n  thigh_mm: 58\n  shin_mm: 56\n  ankle_h_mm: 44\n  hip_roll_above_pitch_mm: 26\n  hip_spacing_mm: 76\n  foot: { length_mm: 92, width_mm: 60, toe_offset_mm: 12 }\ngait:\n  type: static_crouched\n  step_mm: 40\n  step_s: 1.3\n  lateral_shift_mm: 23\n  ik_hz: 100\n  turn: toe_heel_shuffle\nservos:\n  - { id: 1, name: l_hip_roll, model: sts3032, bus: servo_bus_6v, min_deg: -12, max_deg: 12, stand_deg: 0 }\n  - { id: 2, name: l_hip_pitch, model: sts3215, bus: servo_bus, min_deg: -90, max_deg: 15, stand_deg: 0 }\n  - { id: 3, name: l_knee, model: sts3215, bus: servo_bus, min_deg: 0, max_deg: 120, stand_deg: 0 }\n  - { id: 4, name: l_ankle_pitch, model: sts3215, bus: servo_bus, min_deg: -20, max_deg: 20, stand_deg: 0 }\n  - { id: 5, name: l_ankle_roll, model: sts3032, bus: servo_bus_6v, min_deg: -12, max_deg: 12, stand_deg: 0 }\n  - { id: 6, name: r_hip_roll, model: sts3032, bus: servo_bus_6v, min_deg: -12, max_deg: 12, stand_deg: 0 }\n  - { id: 7, name: r_hip_pitch, model: sts3215, bus: servo_bus, min_deg: -90, max_deg: 15, stand_deg: 0 }\n  - { id: 8, name: r_knee, model: sts3215, bus: servo_bus, min_deg: 0, max_deg: 120, stand_deg: 0 }\n  - { id: 9, name: r_ankle_pitch, model: sts3215, bus: servo_bus, min_deg: -20, max_deg: 20, stand_deg: 0 }\n  - { id: 10, name: r_ankle_roll, model: sts3032, bus: servo_bus_6v, min_deg: -12, max_deg: 12, stand_deg: 0 }\nservo_limits: { temp_warn_c: 65, temp_trip_c: 70, rest_torque_pct: 20, fall_torque_pct: 10 }\nperipherals:\n  - { name: servo_pwr,  part: efuse, en: 14, fault: 21, bus: servo_bus }\n  - { name: servo_pwr_6v, part: efuse, en: 47, fault: 41, bus: servo_bus_6v, supply: buck_6v_5a }\n  - { name: imu,        part: bno085,   bus: i2c0, addr: 0x4A, int: 7, rst: 6, location: hips, role: imu }\n  - { name: lidar_fwd,  part: vl53l8cx, bus: i2c0, addr: 0x29, lpn: 4, int: 5, zones: 8x8, role: obstacle }\n  - { name: drop_front, part: vl53l0x,  bus: i2c0, addr: 0x30, xshut: 10, look_ahead_mm: 80, pitch_comp: true, role: drop_off }\n  - { name: drop_rear,  part: vl53l0x,  bus: i2c0, addr: 0x31, xshut: 11, look_ahead_mm: 60, mount: tail_skid, role: drop_off }\n  - { name: charger,    part: bq25798,  bus: i2c0, addr: 0x6B, int: 12 }\n  - { name: gauge,      part: sbs_pack, bus: i2c1_smb, addr: 0x0B }\n  - { name: face_wake,  gpio: 46, to: face.gpio3 }\n  - { name: status_led, part: ws2812, gpio: 48 }\n  - { name: display,    part: gc9a01,    bus: spi0, dc: 25, rst: 24, bl_pwm: 13, size: 240x240 }\n  - { name: mics,       part: ics43434,  bus: i2s, count: 2, sel: [gnd, 3v3], location: head }\n  - { name: speaker_amp, part: max98357a, bus: i2s, sd: 16 }\n  - { name: camera,     part: imx708,    bus: csi, location: head }\nposes:\n  sit: { hip_pitch: -66, knee: 100, ankle_pitch: -15, torso_back_deg: 19 }\nreflexes:\n  edge:     { sensors: [drop_front, drop_rear], action: [finish_step_back, stop] }\n  obstacle: { sensor: lidar_fwd, stop_mm: 120 }\n  fall:     { sensor: imu, tilt_deg: 35, action: torque_10 }\nsafety:\n  triggers: [heartbeat_lost, soc_below_15, vbat_below_10v5, servo_overtemp, efuse_fault, swing_leg_snag]\n  routine:  [finish_step, stop, hold, wait_2s, crouch_slow, sit_on_skid, torque_low, face_sleepy]\n  resume:   fresh_command_only\n",
