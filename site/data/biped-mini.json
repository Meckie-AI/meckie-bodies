  "targets": [
    {
      "key": "reflex",
      "role": "body",
      "host": null,
      "mcu": "esp32s3",
      "board": "esp32-s3-devkitc-1",
      "platform": "espressif32@6.6.0",
      "flash": {
        "method": "usb_serial",
        "tool": "esptool_js",
        "erase": true
      },
      "os": null,
      "provision": null
    },
    {
      "key": "face",
      "role": null,
      "host": "rpi_zero_2w",
      "mcu": null,
      "board": null,
      "platform": null,
      "flash": {
        "method": "sd_card",
