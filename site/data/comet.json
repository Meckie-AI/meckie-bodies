  "wizard": [
    {
      "step": "servo_ids",
      "prompt": "Connect one servo at a time; Hangar Bay assigns IDs 1-12 (FL, FR, RL, RR; abduction, hip pitch, knee)",
      "required": false,
      "writes": null,
      "checks": null,
      "auto": true
    },
    {
      "step": "servo_center",
      "prompt": "Set each leg to the printed stance jig and confirm",
      "required": false,
      "writes": "servos[].offset_deg",
      "checks": null,
      "auto": false
    },
    {
      "step": "knee_rod",
      "prompt": "Adjust each turnbuckle until the knee reads zero (front 149.5 mm, rear 129.2 mm)",
      "required": false,
      "writes": "servos[].offset_deg",
      "checks": null,
      "auto": false
    },
    {
      "step": "wheel_direction",
      "prompt": "Lift the body; Hangar Bay spins each wheel forward briefly",
      "required": false,
      "writes": "drive.invert",
      "checks": null,
      "auto": false
    },
    {
      "step": "imu_level",
      "prompt": "Place the body on a flat surface",
      "required": false,
      "writes": "imu.offsets",
      "checks": null,
      "auto": false
    },
    {
      "step": "tof_check",
      "prompt": "Hold a hand 10 cm in front of each sensor",
      "required": false,
      "writes": null,
      "checks": [
        "lidar_fwd",
        "drop_fl",
        "drop_fr",
        "drop_rl",
        "drop_rr"
      ],
      "auto": false
    },
    {
      "step": "safety_test",
      "prompt": "Hangar Bay drops the heartbeat; Comet must brake, wait, and crouch",
      "required": true,
      "writes": null,
      "checks": null,
      "auto": false
    }
  ],
