  "manifest_text": "body: dial\ndoctrine: thin-client\ncentral: { link: wifi, heartbeat_hz: 10, timeout_ms: 500 }\nmcu:\n  reflex: { chip: esp32s3, module: N16R8, reserved_gpio: [26-37] }\n  face:   { chip: rpi_zero_2w, os: bookworm-lite, location: head }\nbuses:\n  servo_bus: { host: reflex, uart: 1, tx: 17, rx: 18, baud: 1000000, half_duplex: true }\n  i2c0:      { host: reflex, sda: 8,  scl: 9,  hz: 400000 }\n  i2c1_smb:  { host: reflex, sda: 10, scl: 11, hz: 100000 }\n  link:      { reflex: { uart: 2, tx: 15, rx: 16 }, face: { uart: 0, tx: 14, rx: 15 }, baud: 921600 }\n  spi0:      { host: face, mosi: 10, sclk: 11, cs: 8, hz: 62500000 }\n  i2s:       { host: face, bclk: 18, lrclk: 19, din: 20, dout: 21, rate: 48000 }\n  csi:       { host: face, port: cam0 }\nservos:\n  - { id: 1, name: pan,  model: sts3215, center: 2048, min: 341,  max: 3755, rest: 2048 }\n  - { id: 2, name: tilt, model: sts3215, center: 2048, min: 1707, max: 2503, rest: 1764 }\nservo_limits: { temp_warn_c: 65, temp_trip_c: 70, rest_torque_pct: 20, slow_dps: 30 }\nperipherals:\n  - { name: tof_front,  part: vl53l8cx,  bus: i2c0, addr: 0x29, lpn: 4, int: 5, role: presence }\n  - { name: charger,    part: bq25798,   bus: i2c0, addr: 0x6B, int: 6, ce: 7 }\n  - { name: gauge,      part: sbs_pack,  bus: i2c1_smb, addr: 0x0B }\n  - { name: servo_pwr,  part: efuse,     en: 12, fault: 13 }\n  - { name: face_wake,  gpio: 14, to: face.gpio3 }\n  - { name: status_led, part: ws2812,    gpio: 48 }\n  - { name: display,    part: st7789v,   bus: spi0, dc: 25, rst: 24, bl_pwm: 13, size: 320x240, rotation: 90 }\n  - { name: mics,       part: ics43434,  bus: i2s, count: 2, sel: [gnd, 3v3], spacing_mm: 92 }\n  - { name: speaker_amp, part: max98357a, bus: i2s, sd: 16 }\n  - { name: camera,     part: imx708,    bus: csi }\nsensing_rule: { drives: false, forward_lidar: tof_front, drop_off: not_applicable_fixed_base }\nsafety:\n  triggers: [heartbeat_lost, soc_below_15, vbat_below_10v5, servo_overtemp, efuse_fault]\n  routine:  [stop, brake, wait_2s, slow_to_rest, torque_low, face_sleepy]\n  resume:   fresh_command_only\n",
